{
  "name": "stuffed",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @stuffed/client --filter @stuffed/server dev",
    "build": "pnpm --filter @stuffed/client build",
    "test": "pnpm --filter @stuffed/sim test && vitest run apps/server/test",
    "typecheck": "pnpm -r typecheck",
    "sfx": "node tools/generate-sfx.mjs",
    "dev:lan": "pnpm --parallel --filter @stuffed/client --filter @stuffed/server dev:lan",
    "dev:solo": "pnpm --filter @stuffed/client dev",
    "deploy": "VITE_CANONICAL_ORIGIN=https://pluffs.cz pnpm build && pnpm --filter @stuffed/server run deploy",
    "errors": "pnpm --filter @stuffed/server run errors",
    "music": "node tools/generate-music.mjs",
    "textures": "node tools/generate-textures.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
